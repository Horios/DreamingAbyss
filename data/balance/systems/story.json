      "prerequisites": [],
      "entry": "creation",
      "stages": [
        {
          "id": "creation",
          "name": "造物",
          "speaker": "女神",
          "description": "在造物室醒來。",
          "dialogue": [
            {
              "speaker": "旁白",
              "kind": "narrator",
              "text": "一間神祕的房間內，無源之光亮起。",
              "source": "original"
            },
            {
              "speaker": "旁白",
              "kind": "narrator",
              "text": "咚咚，咚咚……",
              "source": "original"
            },
            {
              "speaker": "旁白",
              "kind": "narrator",
              "text": "最初聽到的，是腳步聲。",
              "source": "original"
            },
            {
              "speaker": "旁白",
              "kind": "narrator",
              "text": "一道矮小的身影披著寬大的長袍，走進了房間。",
              "source": "draft"
            },
            {
              "speaker": "旁白",
              "kind": "narrator",
              "text": "「知識」、「認知」、「天賦」……她伸出手，一顆顆光點在掌心上方匯聚成光團。",
              "source": "draft"
            },
            {
              "speaker": "旁白",
              "kind": "narrator",
